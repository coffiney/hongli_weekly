# ============ hongli_weekly LLM 配置 ============
# 复制本文件为 .env（同目录），填好后重跑流水线即可自动启用 LLM 点评。
#   cp .env.example .env  然后编辑 .env

# LLM API Key（必填）
HONGLI_LLM_API_KEY=

# API 地址（必填，openai 兼容格式，结尾不带 /v1 也能自动补，但建议写全）
# 智谱 GLM:      https://open.bigmodel.cn/api/paas/v4
# DeepSeek:      https://api.deepseek.com/v1
# 通义千问:       https://dashscope.aliyuncs.com/compatible-mode/v1
# 月之暗面 Kimi:  https://api.moonshot.cn/v1
HONGLI_LLM_BASE_URL=

# 模型名（可选，默认 glm-4.7；按你的服务商填写，如 deepseek-chat / qwen-plus / moonshot-v1-32k）
HONGLI_LLM_MODEL=glm-4.7

# 飞书机器人 webhook（可选）：配置后流水线跑完自动推送周报到飞书群
# HONGLI_FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
